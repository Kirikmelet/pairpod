{
  "manifest_version": 3,
  "name": "PairPod",
  "short_name": "PairPod",
  "key": "",
  "version": "0.1.0",
  "description": "Browser extension shell for the PairPod Next.js app.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PairPod",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "identity",
    "storage",
    "tabs"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "uncommonhacks@uncommonhacks.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  },
  "host_permissions": [
    "https://xgfgqzveuyeceupfaebh.supabase.co/*",
    "http://localhost:3000/*"
  ]
}
